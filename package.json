{
  "name": "businessos",
  "version": "0.1.0",
  "private": true,
  "description": "BusinessOS — modern desktop business management",
  "main": "electron/main.js",
  "scripts": {
    "next:dev": "next dev -p 3100",
    "next:build": "cross-env NEXT_OUTPUT_MODE=export next build",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "build": "npm run next:build && npm run server:build",
    "electron:dev": "wait-on http://localhost:3100 && wait-on http://localhost:4000/api/health && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k -n NEXT,API,APP -c blue,green,magenta \"npm:next:dev\" \"npm:server:dev\" \"npm:electron:dev\"",
    "start": "cross-env NODE_ENV=production electron .",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-label": "^2.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1",
    "pdfkit": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-notifier": "^8.0.5",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.businessos.app",
    "productName": "BusinessOS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "dist-server/**/*",
      "prisma/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
